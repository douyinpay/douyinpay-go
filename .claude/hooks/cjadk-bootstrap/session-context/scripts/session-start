#!/usr/bin/env bash
# cjadk built-in SessionStart hook: injects sdd-guide SKILL.md inline so the
# SDD workflow router (including its OPT-IN-GATE) is visible at session
# start. The gate inside SKILL.md is what prevents auto-entry; this hook just
# delivers it.
#
# sdd-guide is installed by `cjadk init` from the git plugin market
# (public/common/cjadk-sdd); this hook reads its install location in the global
# plugin store, falling back to the legacy global-skills path when init used the
# offline bundle copy. If sdd-guide is unavailable, the hook silently skips
# context injection.

set -euo pipefail

candidate_paths=(
    "${CJADK_HOME:-${HOME}/.cjadk}/plugins/public/common/cjadk-sdd/skills/sdd-guide/SKILL.md"
    "${XDG_DATA_HOME:-${HOME}/.local/share}/cjadk/skills/cjadk/sdd-guide/SKILL.md"
    "${LOCALAPPDATA:-${HOME}/AppData/Local}/cjadk/skills/cjadk/sdd-guide/SKILL.md"
)

sdd_guide_path=""
for candidate in "${candidate_paths[@]}"; do
    if [ -f "$candidate" ]; then
        sdd_guide_path="$candidate"
        break
    fi
done

if [ -z "$sdd_guide_path" ]; then
    exit 0
fi

sdd_guide_content=$(cat "$sdd_guide_path" 2>/dev/null) || exit 0

read -r -d '' WRAPPER <<'EOF' || true
<EXTREMELY_IMPORTANT>
You have cjadk:sdd skills.

**Below is the full content of your 'cjadk:sdd-guide' skill — your guide to picking the right sdd-* skill. Honor its OPT-IN-GATE: do not auto-enter the SDD workflow unless the user invokes a /sdd-* slash command or explicitly asks for SDD. For all other skills, use the 'Skill' tool:**

EOF

INJECTION="${WRAPPER}

${sdd_guide_content}
</EXTREMELY_IMPORTANT>"

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

ESCAPED=$(escape_for_json "$INJECTION")

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
    printf '{\n  "additional_context": "%s"\n}\n' "$ESCAPED"
elif [ -n "${COPILOT_CLI:-}" ]; then
    printf '{\n  "additionalContext": "%s"\n}\n' "$ESCAPED"
else
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$ESCAPED"
fi

exit 0
